datasource db {
  provider = "mysql"
   url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  
  metaKeyword     String?  @db.Text
  metaDescription String?  @db.Text
  body            String   @db.LongText
  imageUrl        String?
  category        Category
  contentType     ContentType
  createdAt       DateTime @default(now())
}


enum Category {
  GREEN_COFFEE_BENEFITS
  TYPES_OF_GREEN_COFFEE_BEANS
  HOW_TO_USE_GREEN_COFFEE
  GREEN_COFFEE_WEIGHT_LOSS
  GREEN_COFFEE_HEALTH
  GREEN_COFFEE_STORAGE_CARE
}

enum ContentType {
  ARTICLE
  NEWS
}


model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          String   @default("editor")
  mustChangePassword  Boolean  @default(true)   // 👈 new field
  createdAt     DateTime @default(now())
  resetToken       String?  
  resetTokenExpiry DateTime?
}
