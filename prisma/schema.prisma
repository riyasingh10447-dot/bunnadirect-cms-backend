datasource db {
  provider = "mysql"
   url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model Article {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  metaKeyword    String?
  metaDescription String?
  body      String   @db.LongText
  imageUrl       String?
  category       Category
  contentType    ContentType
  createdAt      DateTime  @default(now())
}

enum Category {
  GENERAL_HEALTH
    DISEASES_CONDITIONS
   MEDICINES_PHARMA
    LAB_TESTS
    SURGICAL_PROCEDURES
    MENTAL_HEALTH
  NUTRITION_DIET
    FITNESS_EXERCISE
  HEALTHCARE_TECHNOLOGY
    AYURVEDA_HERBAL
  SKIN_HAIR_CARE
   MOTHER_CHILD_HEALTH
}

enum ContentType {
  ARTICLE
  NEWS
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          String   @default("editor")
  mustChangePassword  Boolean  @default(true)   // 👈 new field
  createdAt     DateTime @default(now())
  resetToken       String?  
  resetTokenExpiry DateTime?
}
